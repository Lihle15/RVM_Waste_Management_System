@model RVMWMApp.Models.IllegalDumpingReport

@{
    ViewData["Title"] = "Report Illegal Dumping";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="text-center mb-1">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>Report Illegal Dumping
                    </h3>
                    <p class="text-muted text-center mb-4">
                        Spotted waste dumped where it shouldn't be? Tell us where and what, and we'll review it.
                    </p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">Location *</label>
                            <input asp-for="Location" class="form-control" placeholder="Street, suburb or area" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Landmark" class="form-label">Nearby landmark</label>
                            <input asp-for="Landmark" class="form-control" placeholder="e.g. next to the taxi rank, behind the school" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="WasteType" class="form-label">Type of waste</label>
                                <select asp-for="WasteType" class="form-select">
                                    <option value="">Select type</option>
                                    <option>Household waste</option>
                                    <option>Garden waste</option>
                                    <option>Building rubble</option>
                                    <option>Plastic</option>
                                    <option>Glass</option>
                                    <option>Tyres</option>
                                    <option>Electronic waste</option>
                                    <option>Hazardous / chemicals</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EstimatedQuantity" class="form-label">Estimated amount</label>
                                <input asp-for="EstimatedQuantity" class="form-control" placeholder="e.g. 5 bags, one bakkie load" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="What did you see? How long has it been there? Is it a danger to people or animals?"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="fas fa-paper-plane me-2"></i>Submit Report
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to My Reports
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
