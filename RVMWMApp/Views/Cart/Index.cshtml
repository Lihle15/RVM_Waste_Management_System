@model List<RVMWMApp.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<div class="container mt-4">
    <h2>Your Shopping Cart</h2>
    <hr />

    @if (!Model.Any())
    {
        <p>Your cart is empty.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" width="50" height="50" class="me-2" />
                            @item.ProductName
                        </td>
                        <td>R@item.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>R@item.Total.ToString("F2")</td>
                        <td>
                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <button class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-3">
            <h4>Total: <strong>R@Model.Sum(i => i.Total).ToString("F2")</strong></h4>
            <a asp-action="Checkout" class="btn btn-success mt-2">Proceed to Checkout</a>
        </div>
    }
</div>
