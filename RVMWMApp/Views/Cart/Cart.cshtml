 @model IEnumerable<RVMWMApp.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal grandTotal = 0;
}

<div class="container mt-5">
    <h2 class="mb-4">Your Cart</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price (ZAR)</th>
                    <th>Quantity</th>
                    <th>Total (ZAR)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var total = item.Price * item.Quantity;
                    grandTotal += total;

                    <tr>
                        <td>@item.ProductName</td>
                        <td>R@item.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>R@total.ToString("F2")</td>
                        <td>
                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                <!-- Pass ProductId to match controller -->
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Grand Total:</th>
                    <th>R@grandTotal.ToString("F2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-end mt-3 gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-success">Proceed to Checkout</a>
        </div>
    }
</div>
