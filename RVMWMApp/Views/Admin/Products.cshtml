@model List<Product>
@{
    ViewData["Title"] = "Product Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-boxes me-2"></i>Product Management</h2>
                    <p class="text-muted mb-0">Manage your product catalog and inventory.</p>
                </div>
                <div>
                    <a asp-controller="Products" asp-action="Create" class="btn btn-primary-premium">
                        <i class="fas fa-plus me-2"></i>Add New Product
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-primary">@Model.Count</h5>
                    <small class="text-muted">Total Products</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-warning">@Model.Count(p => p.Stock < 10)</h5>
                    <small class="text-muted">Low Stock</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-success">@Model.Count(p => p.IsFeatured)</h5>
                    <small class="text-muted">Featured</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-info">@Model.Count(p => p.IsOnSale)</h5>
                    <small class="text-muted">On Sale</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card card-premium">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Product Catalog</h5>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="exportProducts()">
                            <i class="fas fa-download me-1"></i>Export
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Rating</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="product-image-sm me-3">
                                                        <i class="fas fa-box"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@product.Name</strong>
                                                        <br>
                                                        <small class="text-muted">@(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@product.Category</span>
                                            </td>
                                            <td>
                                                <strong class="text-primary">R@(product.Price.ToString("F2"))</strong>
                                            </td>
                                            <td>
                                                <span class="badge @(product.Stock > 10 ? "bg-success" : product.Stock > 0 ? "bg-warning" : "bg-danger")">
                                                    @product.Stock
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= product.Rating)
                                                        {
                                                            <i class="fas fa-star text-warning small"></i>
                                                        }
                                                        else if (i == (int)product.Rating + 1 && product.Rating % 1 >= 0.5)
                                                        {
                                                            <i class="fas fa-star-half-alt text-warning small"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star text-warning small"></i>
                                                        }
                                                    }
                                                    <small class="text-muted ms-1">(@product.ReviewCount)</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="status-badges">
                                                    @if (product.IsFeatured)
                                                    {
                                                        <span class="badge bg-success me-1">Featured</span>
                                                    }
                                                    @if (product.IsOnSale)
                                                    {
                                                        <span class="badge bg-danger me-1">Sale</span>
                                                    }
                                                    @if (product.Stock == 0)
                                                    {
                                                        <span class="badge bg-dark">Out of Stock</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id"
                                                       class="btn btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <form asp-action="ToggleProductFeatured" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@product.Id" />
                                                        <button type="submit" class="btn @(product.IsFeatured ? "btn-warning" : "btn-outline-warning")"
                                                                title="@(product.IsFeatured ? "Remove from Featured" : "Add to Featured")">
                                                            <i class="fas @(product.IsFeatured ? "fa-star" : "fa-star")"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="d-inline">
                                                        <input type="hidden" name="id" value="@product.Id" />
                                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-boxes fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Products Found</h4>
                            <p class="text-muted">Get started by adding your first product to the catalog.</p>
                            <a asp-controller="Products" asp-action="Create" class="btn btn-primary-premium">
                                <i class="fas fa-plus me-2"></i>Add First Product
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-image-sm {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .status-badges .badge {
        font-size: 0.65rem;
        padding: 0.2rem 0.4rem;
    }

    .table td {
        vertical-align: middle;
    }
</style>

<script>
    function exportProducts() {
        alert('Product export feature would be implemented here!');
        // In a real application, this would generate a CSV/Excel file
    }
</script>