@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
                    <p class="text-muted mb-0">Welcome to your RVM Management System administration panel.</p>
                </div>
                <div class="text-end">
                    <small class="text-muted">Last updated: @DateTime.Now.ToString("HH:mm:ss")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-users fa-2x text-primary mb-3"></i>
                    <h3 class="text-primary">@Model.TotalUsers</h3>
                    <p class="mb-0 fw-bold">Total Users</p>
                    <small class="text-muted">Registered accounts</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-shopping-bag fa-2x text-success mb-3"></i>
                    <h3 class="text-success">@Model.TotalProducts</h3>
                    <p class="mb-0 fw-bold">Products</p>
                    <small class="text-muted">In catalog</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-robot fa-2x text-info mb-3"></i>
                    <h3 class="text-info">@Model.TotalRVMs</h3>
                    <p class="mb-0 fw-bold">Total RVMs</p>
                    <small class="text-muted">Machines deployed</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-play-circle fa-2x text-warning mb-3"></i>
                    <h3 class="text-warning">@Model.ActiveRVMs</h3>
                    <p class="mb-0 fw-bold">Active RVMs</p>
                    <small class="text-muted">Currently online</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-exclamation-triangle fa-2x text-danger mb-3"></i>
                    <h3 class="text-danger">@Model.LowStockProducts</h3>
                    <p class="mb-0 fw-bold">Low Stock</p>
                    <small class="text-muted">Need restocking</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card card-premium text-center h-100">
                <div class="card-body">
                    <i class="fas fa-chart-line fa-2x text-secondary mb-3"></i>
                    <h3 class="text-secondary">R@(Model.TotalRevenue.ToString("N0"))</h3>
                    <p class="mb-0 fw-bold">Inventory Value</p>
                    <small class="text-muted">Total stock value</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Quick Actions -->
        <div class="col-lg-4 mb-4">
            <div class="card card-premium h-100">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                    <span class="badge bg-primary">Admin</span>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-action="Products" class="btn btn-primary-premium btn-lg">
                            <i class="fas fa-boxes me-2"></i>Manage Products
                        </a>
                        <a asp-action="RVMs" class="btn btn-success-premium btn-lg">
                            <i class="fas fa-robot me-2"></i>Manage RVMs
                        </a>
                        <a asp-action="Users" class="btn btn-info btn-lg text-white">
                            <i class="fas fa-users-cog me-2"></i>Manage Users
                        </a>
                        <a asp-action="System" class="btn btn-warning btn-lg text-dark">
                            <i class="fas fa-cogs me-2"></i>System Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="col-lg-4 mb-4">
            <div class="card card-premium h-100">
                <div class="card-header-premium">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Activity</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivity.Any())
                    {
                        <div class="activity-timeline">
                            @foreach (var activity in Model.RecentActivity)
                            {
                                <div class="activity-item mb-3">
                                    <div class="activity-badge"></div>
                                    <div class="activity-content">
                                        <small class="text-muted">@activity</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No recent activity.</p>
                    }
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="col-lg-4 mb-4">
            <div class="card card-premium h-100">
                <div class="card-header-premium">
                    <h5 class="mb-0"><i class="fas fa-server me-2"></i>System Status</h5>
                </div>
                <div class="card-body">
                    <div class="system-status">
                        <div class="status-item d-flex justify-content-between align-items-center mb-3 p-2 rounded">
                            <div>
                                <i class="fas fa-database me-2 text-primary"></i>
                                <strong>Database</strong>
                            </div>
                            <span class="badge bg-success">Connected</span>
                        </div>
                        <div class="status-item d-flex justify-content-between align-items-center mb-3 p-2 rounded">
                            <div>
                                <i class="fas fa-robot me-2 text-info"></i>
                                <strong>RVMs Online</strong>
                            </div>
                            <span class="badge bg-success">@Model.ActiveRVMs / @Model.TotalRVMs</span>
                        </div>
                        <div class="status-item d-flex justify-content-between align-items-center mb-3 p-2 rounded">
                            <div>
                                <i class="fas fa-shield-alt me-2 text-success"></i>
                                <strong>Security</strong>
                            </div>
                            <span class="badge bg-success">Active</span>
                        </div>
                        <div class="status-item d-flex justify-content-between align-items-center mb-3 p-2 rounded">
                            <div>
                                <i class="fas fa-network-wired me-2 text-warning"></i>
                                <strong>API Services</strong>
                            </div>
                            <span class="badge bg-success">Online</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .activity-timeline {
        position: relative;
        padding-left: 20px;
    }

    .activity-item {
        position: relative;
        padding-left: 15px;
    }

    .activity-badge {
        position: absolute;
        left: -8px;
        top: 5px;
        width: 12px;
        height: 12px;
        background: var(--primary);
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 0 0 2px var(--primary);
    }

    .activity-item:not(:last-child)::before {
        content: '';
        position: absolute;
        left: -2px;
        top: 17px;
        bottom: -15px;
        width: 2px;
        background: #e9ecef;
    }

    .status-item:hover {
        background: rgba(0,0,0,0.02);
    }
</style>