@model List<ReverseVendingMachine>
@{
    ViewData["Title"] = "RVM Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-robot me-2"></i>RVM Management</h2>
                    <p class="text-muted mb-0">Monitor and manage your Reverse Vending Machines.</p>
                </div>
                <div>
                    <a asp-controller="RVMs" asp-action="Create" class="btn btn-primary-premium">
                        <i class="fas fa-plus me-2"></i>Add New RVM
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- RVM Statistics -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-primary">@Model.Count</h5>
                    <small class="text-muted">Total RVMs</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-success">@Model.Count(r => r.IsActive)</h5>
                    <small class="text-muted">Active</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-warning">@Model.Count(r => r.CurrentLoad >= r.Capacity * 0.8m)</h5>
                    <small class="text-muted">High Capacity</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-premium text-center">
                <div class="card-body py-3">
                    <h5 class="text-info">@Model.Sum(r => r.CurrentLoad)</h5>
                    <small class="text-muted">Total Load (kg)</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card card-premium">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>All RVMs</h5>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="exportRVMs()">
                            <i class="fas fa-download me-1"></i>Export
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Machine</th>
                                        <th>Location</th>
                                        <th>Capacity</th>
                                        <th>Current Load</th>
                                        <th>Status</th>
                                        <th>Utilization</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rvm in Model)
                                    {
                                        var percentage = rvm.Capacity > 0 ? (int)((decimal)rvm.CurrentLoad / rvm.Capacity * 100) : 0;
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="rvm-icon me-3">
                                                        <i class="fas fa-robot"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@rvm.MachineName</strong>
                                                        <br>
                                                        <small class="text-muted">ID: @rvm.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <i class="fas fa-map-marker-alt text-danger me-1"></i>
                                                    @rvm.Location
                                                </div>
                                            </td>
                                            <td>
                                                <strong>@rvm.Capacity kg</strong>
                                            </td>
                                            <td>
                                                <span class="badge @GetLoadBadgeClass(percentage)">@rvm.CurrentLoad kg</span>
                                            </td>
                                            <td>
                                                <span class="badge @(rvm.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(rvm.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress me-2" style="width: 100px; height: 8px;">
                                                        <div class="progress-bar @GetProgressBarClass(percentage)"
                                                             style="width: @percentage%"></div>
                                                    </div>
                                                    <small class="text-muted">@percentage%</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="RVMs" asp-action="Edit" asp-route-id="@rvm.Id"
                                                       class="btn btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <form asp-action="ToggleRVMStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@rvm.Id" />
                                                        <button type="submit" class="btn @(rvm.IsActive ? "btn-warning" : "btn-outline-warning")"
                                                                title="@(rvm.IsActive ? "Deactivate" : "Activate")">
                                                            <i class="fas @(rvm.IsActive ? "fa-pause" : "fa-play")"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-action="DeleteRVM" method="post" onsubmit="return confirm('Are you sure you want to delete this RVM?');" class="d-inline">
                                                        <input type="hidden" name="id" value="@rvm.Id" />
                                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-robot fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No RVMs Found</h4>
                            <p class="text-muted">Get started by adding your first Reverse Vending Machine.</p>
                            <a asp-controller="RVMs" asp-action="Create" class="btn btn-primary-premium">
                                <i class="fas fa-plus me-2"></i>Add First RVM
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rvm-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #00A8E8 0%, #0077B6 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .table td {
        vertical-align: middle;
    }
</style>

<script>
    function exportRVMs() {
        alert('RVM export feature would be implemented here!');
        // In a real application, this would generate a CSV/Excel file
    }
</script>

@functions {
    public string GetLoadBadgeClass(int percentage)
    {
        return percentage switch
        {
            >= 80 => "bg-danger",
            >= 60 => "bg-warning",
            _ => "bg-success"
        };
    }

    public string GetProgressBarClass(int percentage)
    {
        return percentage switch
        {
            >= 80 => "bg-danger",
            >= 60 => "bg-warning",
            _ => "bg-success"
        };
    }
}