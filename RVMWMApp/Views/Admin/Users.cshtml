@model List<UserWithRolesViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-users-cog me-2"></i>User Management</h2>
                    <p class="text-muted mb-0">Manage system users and their roles.</p>
                </div>
                <div>
                    <span class="badge bg-primary">@Model.Count Users</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card card-premium">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>All Users</h5>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="exportUsers()">
                            <i class="fas fa-download me-1"></i>Export
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Roles</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var userWithRoles in Model)
                                    {
                                        var user = userWithRoles.User;
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle me-3">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@(user?.FullName ?? "N/A")</strong>
                                                        <br>
                                                        <small class="text-muted">@(user?.UserName ?? "N/A")   </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@(user?.Email ?? "N/A")</td>
                                            <td>
                                                <div class="role-badges">
                                                    @foreach (var role in userWithRoles.Roles)
                                                    {
                                                        <span class="badge @GetRoleBadgeClass(role) me-1">@role</span>
                                                    }
                                                    @if (!userWithRoles.Roles.Any())
                                                    {
                                                        <span class="badge bg-secondary">No Roles</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @(user?.EmailConfirmed == true ? "bg-success" : "bg-warning")">
                                                    @(user?.EmailConfirmed == true ? "Verified" : "Pending")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <!-- Role Management Dropdown -->
                                                    <div class="dropdown me-1">
                                                        <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                            <i class="fas fa-user-shield me-1"></i>Roles
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li><h6 class="dropdown-header">Assign Roles</h6></li>
                                                            @foreach (var role in new[] { "Admin", "Operator", "Customer" })
                                                            {
                                                                var hasRole = userWithRoles.Roles.Contains(role);
                                                                <li>
                                                                    <form asp-action="UpdateUserRole" method="post" class="d-inline">
                                                                        <input type="hidden" name="userId" value="@(user?.Id ?? string.Empty)" />
                                                                        <input type="hidden" name="role" value="@role" />
                                                                        <input type="hidden" name="isAdded" value="@(!hasRole)" />
                                                                        <button type="submit" class="dropdown-item @(hasRole ? "active" : "")">
                                                                            @if (hasRole)
                                                                            {
                                                                                <i class="fas fa-check text-success me-2"></i>
                                                                            }
                                                                            else
                                                                            {
                                                                                <i class="fas fa-plus me-2"></i>
                                                                            }
                                                                            @role
                                                                        </button>
                                                                    </form>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>

                                                    <!-- Delete User -->
                                                    @if (user?.UserName != User.Identity?.Name)
                                                    {
                                                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                            <input type="hidden" name="userId" value="@(user?.Id ?? string.Empty)" />
                                                            <button type="submit" class="btn btn-outline-danger">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-secondary" disabled title="Cannot delete your own account">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Users Found</h4>
                            <p class="text-muted">There are no users in the system yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .role-badges .badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }

    .table td {
        vertical-align: middle;
    }
</style>

<script>
    function exportUsers() {
        alert('Export feature would be implemented here!');
        // In a real application, this would generate a CSV/Excel file
    }
</script>

@functions {
    public string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Admin" => "bg-danger",
            "Operator" => "bg-warning",
            "Customer" => "bg-info",
            _ => "bg-secondary"
        };
    }
}