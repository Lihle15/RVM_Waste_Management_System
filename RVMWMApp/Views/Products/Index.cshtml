                        <img src="~/images/RP1.png" class="card-img-top" alt="RP1" style="height:200px; object-fit:cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">Recycled PET Bottles (Grade A)</h5>
                            <p class="card-text flex-grow-1">High-quality recycled PET bottles suitable for various manufacturing applications.</p>
                            <span class="h4 text-primary mb-2">R100.00</span>
                            <span class="badge bg-success mb-2">10 available</span>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="id" value="1" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-success w-100 mb-2">Add to Cart</button>
                            </form>

                            <a asp-action="Details" asp-route-id="1" class="btn btn-outline-primary w-100">View Details</a>
