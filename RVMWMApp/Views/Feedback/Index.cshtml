@model List<Feedback>
@{
    ViewData["Title"] = "Customer Reviews";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2><i class="fas fa-comments me-2"></i>Customer Reviews</h2>
            <p class="lead">See what our community says about recycling with RVM</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <div class="card card-premium">
                <div class="card-header-premium text-center">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i>Share Your Experience</h5>
                </div>
                <div class="card-body">
                    <a asp-action="Create" class="btn btn-primary-premium w-100 btn-lg">
                        <i class="fas fa-edit me-2"></i>Write a Review
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var review in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-premium h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <strong>@review.User?.FullName</strong>
                                <br>
                                <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star@(i <= review.Rating ? "" : "-o")"></i>
                                }
                            </div>
                        </div>
                        <p class="card-text">"@review.Comment"</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>